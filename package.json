{
  "name": "kkiapay-react",
  "version": "0.0.3",
  "description": "React hook for integrating KKiaPay payment gateway",
  "type": "module",
  "keywords": [
    "kkiapay",
    "payment",
    "react",
    "hook",
    "africa",
    "mobile-money",
    "payment-gateway",
    "typescript",
    "react-hook"
  ],
  "author": "KKiaPay <support@kkiapay.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kkiapay/kkiapay-react.git"
  },
  "homepage": "https://github.com/kkiapay/kkiapay-react#readme",
  "bugs": {
    "url": "https://github.com/kkiapay/kkiapay-react/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/kkiapay-react.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/kkiapay-react.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc --p ./tsconfig-build.json && vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "preview": "vite preview",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "release": "bumpp"
  },
  "dependencies": {
    "bumpp": "^10.3.1",
    "kkiapay": "^2.0.36"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^20.8.4",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^23.0.1",
    "prettier": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^4.4.5",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
